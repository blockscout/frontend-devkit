{
  // Standalone on purpose: the tool is compiled inside whichever repository consumes it, so it
  // must not extend a root config that differs per consumer.
  "compilerOptions": {
    "module": "node16",
    "target": "es2022",
    "moduleResolution": "node16",
    "lib": [ "es2022" ],
    "types": [ "node" ],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": ".",
    "outDir": "./dist"
  },
  "include": [
    "./index.ts"
  ],
  "exclude": [
    "**/*.spec.ts"
  ]
}
